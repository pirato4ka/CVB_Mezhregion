///////////////////////////////////////////////////////////////////////////////////////////////////////
// Форма элемента справочника Блюда.
//
// Требование задания: фотография блюда хранится в базе, отображается в карточке,
// загружается кнопкой «Выбрать фото» и удаляется кнопкой «Удалить фото».
// При открытии карточки фотография извлекается из хранилища значения и помещается
// во временное хранилище формы - поле картинки отображает её по адресу.
//
// Дополнительно в карточке показана актуальная цена блюда и команда «Установить цену»,
// которая записывает цену в регистр сведений «Цены блюд» текущей датой.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// У нового элемента параметр Ключ платформой не передаётся.
	БлюдоЗаписано = Параметры.Свойство("Ключ");

	ОбновитьФотографиюНаСервере();
	ОбновитьАктуальнуюЦенуНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если Не ЭтоАдресВременногоХранилища(АдресФотографии) Тогда
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФотографии);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущийОбъект.ХранилищеФотографии = Новый ХранилищеЗначения(ДвоичныеДанные);

	// Адрес временного хранилища одноразовый: помещаем фотографию заново,
	// чтобы она осталась на форме после записи.
	АдресФотографии = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(Отказ)

	БлюдоЗаписано = Истина;
	ОбновитьАктуальнуюЦенуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура АдресФотографииНажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	НачатьВыборФайла();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьФото(Команда)
	НачатьВыборФайла();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьФото(Команда)

	Если Не Объект.ЕстьФотография И Не ЗначениеЗаполнено(АдресФотографии) Тогда
		ПоказатьПояснение(НСтр("ru = 'У блюда нет фотографии.'"));
		Возврат;
	КонецЕсли;

	УдалитьФотоНаСервере();
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьЦену(Команда)

	Если Не БлюдоЗаписано Тогда
		ПоказатьПояснение(НСтр("ru = 'Сначала запишите блюдо, затем установите цену.'"));
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(АктуальнаяЦена) Или АктуальнаяЦена <= 0 Тогда
		ПоказатьПояснение(НСтр("ru = 'Укажите цену блюда больше нуля.'"));
		Возврат;
	КонецЕсли;

	УстановитьЦенуНаСервере(АктуальнаяЦена);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Клиент

&НаКлиенте
Процедура НачатьВыборФайла()

	// Немодальный выбор файла: результат приходит в обработчик оповещения.
	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, Неопределено, Неопределено, Истина, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;

	// Фотография сохранится в хранилище значения при записи элемента.
	АдресФотографии = Адрес;
	Объект.ЕстьФотография = Истина;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПояснение(ТекстПояснения)

	// Модальность в конфигурации запрещена - используем немодальное предупреждение.
	ПоказатьПредупреждение(Неопределено, ТекстПояснения, 5);

КонецПроцедуры

#КонецОбласти

#Область Сервер

&НаСервере
Процедура ОбновитьФотографиюНаСервере()

	Если Не ЗначениеЗаполнено(Объект.ХранилищеФотографии) Тогда
		АдресФотографии = "";
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = Объект.ХранилищеФотографии.Получить();
	Если ДвоичныеДанные = Неопределено Тогда
		АдресФотографии = "";
		Возврат;
	КонецЕсли;

	АдресФотографии = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ОбновитьАктуальнуюЦенуНаСервере()

	Если Не БлюдоЗаписано Тогда
		АктуальнаяЦена = 0;
		Возврат;
	КонецЕсли;

	ДанныеЦены = УправлениеДоставкой.АктуальнаяЦенаБлюда(Объект.Ссылка);
	АктуальнаяЦена = ДанныеЦены.Цена;

КонецПроцедуры

&НаСервере
Процедура УдалитьФотоНаСервере()

	Объект.ХранилищеФотографии = Новый ХранилищеЗначения(Неопределено);
	Объект.ЕстьФотография = Ложь;
	АдресФотографии = "";

КонецПроцедуры

&НаСервере
Процедура УстановитьЦенуНаСервере(НоваяЦена)

	Попытка
		УправлениеДоставкой.УстановитьЦенуБлюда(Объект.Ссылка, НоваяЦена);
	Исключение
		СообщитьОбОшибке(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(
		НСтр("ru = 'Цена блюда ""%1"" установлена: %2.'"),
		Строка(Объект.Ссылка), Формат(НоваяЦена, "ЧДЦ=2"));
	Сообщение.Статус = СтатусСообщения.Информация;
	Сообщение.Поле = "АктуальнаяЦена";
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервере
Процедура СообщитьОбОшибке(ТекстСообщения)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Статус = СтатусСообщения.Важное;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#КонецОбласти