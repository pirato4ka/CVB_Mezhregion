///////////////////////////////////////////////////////////////////////////////////////////////////////
// Модуль объекта справочника Блюда.
//
// Признак «Есть фотография» поддерживается автоматически: он используется в списках
// и в АРМ диспетчера, чтобы видеть блюда с фотографией без распаковки хранилища.
///////////////////////////////////////////////////////////////////////////////////////////////////////

Процедура ПередЗаписью(Отказ)

	ЕстьФотография = ФотографияЗаполнена();

КонецПроцедуры

// Проверяет, что в хранилище действительно лежат двоичные данные фотографии.
//
// Возвращаемое значение:
//   Булево - Истина, если фотография загружена.
//
Функция ФотографияЗаполнена()

	Если Не ЗначениеЗаполнено(ХранилищеФотографии) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ДвоичныеДанные = ХранилищеФотографии.Получить();
	Исключение
		Возврат Ложь;
	КонецПопытки;

	Если ДвоичныеДанные = Неопределено
		Или ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ДвоичныеДанные.Размер() > 0;

КонецФункции