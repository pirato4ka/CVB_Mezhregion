Перем ПредыдущийРесторан;

// Форма документа Заказ.
// Клиентская логика: подстановка адреса клиента, подтверждение смены ресторана,
// подбор цены блюда, пересчет суммы без ошибок блокировок.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда
		Объект.ДатаСоздания = ТекущаяДатаСеанса();
		Объект.Дата = Объект.ДатаСоздания;
	КонецЕсли;

	ПредыдущийРесторан = Объект.Ресторан;

КонецПроцедуры

// Клиент

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)

	ОбновитьАдресДоставкиКлиента();

КонецПроцедуры

&НаСервере
Процедура ОбновитьАдресДоставкиКлиента()

	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		Объект.АдресДоставки = Объект.Клиент.ОсновнойАдресДоставки;
	Иначе
		Объект.АдресДоставки = "";
	КонецЕсли;

КонецПроцедуры

// Ресторан

&НаКлиенте
Процедура РесторанПриИзменении(Элемент)

	Если НЕ ТребуетсяПодтверждениеСменыРесторана() Тогда
		Возврат;
	КонецЕсли;

	ОписаниеОповещения = Новый ОписаниеОповещения("РесторанПриИзмененииЗавершение", ЭтотОбъект);
	ТекстВопроса = "Состав заказа относится к другому ресторану. Очистить состав заказа?";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура РесторанПриИзмененииЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ОчиститьСоставНаСервере();
	Иначе
		ВернутьПредыдущийРесторанНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТребуетсяПодтверждениеСменыРесторана()

	Если Объект.Ресторан = ПредыдущийРесторан Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Объект.Состав.Количество() = 0 Тогда
		ПредыдущийРесторан = Объект.Ресторан;
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервере
Процедура ОчиститьСоставНаСервере()

	Объект.Состав.Очистить();
	ПредыдущийРесторан = Объект.Ресторан;
	ПересчитатьИтогиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ВернутьПредыдущийРесторанНаСервере()

	Объект.Ресторан = ПредыдущийРесторан;

КонецПроцедуры

// Табличная часть Состав

&НаКлиенте
Процедура СоставБлюдоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущиеДанные.Блюдо) Тогда
		ТекущиеДанные.Цена = ПолучитьЦенуБлюдаНаСервере(ТекущиеДанные.Блюдо);
	Иначе
		ТекущиеДанные.Цена = 0;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.Количество) Тогда
		ТекущиеДанные.Количество = 1;
	КонецЕсли;

	ПересчитатьСтрокуСостава(ТекущиеДанные);
	ПересчитатьИтогиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоставСтрокаПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Состав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПересчитатьСтрокуСостава(ТекущиеДанные);
	ПересчитатьИтогиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СоставПослеУдаленияСтроки(Элемент)

	ПересчитатьИтогиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуСостава(СтрокаСостава)

	СтрокаСостава.Сумма = Окр(СтрокаСостава.Количество * СтрокаСостава.Цена, 2);

КонецПроцедуры

&НаСервере
Функция ПолучитьЦенуБлюдаНаСервере(Блюдо)

	Цена = Документы.Заказ.ПолучитьЦенуБлюда(Блюдо, Объект.Дата);
	Если Цена = 0 Тогда
		Сообщить("Для блюда """ + Строка(Блюдо) + """ не установлена цена на дату заказа.", СтатусСообщения.Внимание);
	КонецЕсли;

	Возврат Цена;

КонецФункции

&НаСервере
Процедура ПересчитатьИтогиНаСервере()

	Объект.СуммаДокумента = Окр(Объект.Состав.Итог("Сумма"), 2);

КонецПроцедуры
