///////////////////////////////////////////////////////////////////////////////////////////////////////
// Форма документа Заказ.
//
// Логика, заданная техническим заданием:
//   * адрес доставки подставляется из карточки клиента;
//   * при смене ресторана состав заказа очищается после подтверждения пользователя
//     (модальность в конфигурации запрещена, поэтому вопрос немодальный);
//   * блюда выбираются только из выбранного ресторана - поле связано с рестораном
//     параметром выбора Отбор.Ресторан;
//   * при выборе блюда цена подставляется из среза последних регистра «Цены блюд»
//     на дату создания заказа, пустое количество заменяется единицей;
//   * сумма строки и сумма документа пересчитываются автоматически;
//   * если сумма заказа меньше минимальной суммы заказа ресторана, показывается
//     предупреждение (заказ при этом записывается).
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.ДатаСоздания) Тогда
		Объект.ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Статус) Тогда
		Объект.Статус = Перечисления.СтатусыЗаказов.Новый;
	КонецЕсли;

	// Для нового заказа сразу планируем время доставки - диспетчер может его уточнить.
	// При открытии существующего документа платформа передаёт параметр Ключ.
	Если Не Параметры.Свойство("Ключ")
		И Не ЗначениеЗаполнено(Объект.ПлановоеВремяДоставки) Тогда
		Объект.ПлановоеВремяДоставки =
			УправлениеДоставкой.ПлановоеВремяДоставкиПоУмолчанию(Объект.ДатаСоздания);
	КонецЕсли;

	ПредыдущийРесторан = Объект.Ресторан;

	Если ЗначениеЗаполнено(Объект.Ресторан) Тогда
		// На сервере реквизиты ресторана читаются напрямую.
		МинимальнаяСуммаЗаказа = Объект.Ресторан.МинимальнаяСуммаЗаказа;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьПредупреждениеОМинимальнойСумме();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапки

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)

	// Адрес доставки берём из карточки клиента.
	Объект.АдресДоставки = ОсновнойАдресДоставкиКлиента(Объект.Клиент);

КонецПроцедуры

&НаКлиенте
Процедура РесторанПриИзменении(Элемент)

	Если Объект.Состав.Количество() = 0 Тогда
		ЗафиксироватьСменуРесторана();
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("СменаРесторанаЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		НСтр("ru = 'Ресторан изменен. Очистить состав заказа? В заказе могут быть только блюда выбранного ресторана.'"),
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура СменаРесторанаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт

	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.Состав.Очистить();
		ПересчитатьСуммуДокумента();
		ЗафиксироватьСменуРесторана();
	Иначе
		// Состав сохраняем: возвращаем прежний ресторан, чтобы заказ остался непротиворечивым.
		Объект.Ресторан = ПредыдущийРесторан;
		ОбновитьМинимальнуюСуммуЗаказа();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицы

&НаКлиенте
Процедура СоставБлюдоПриИзменении(Элемент)

	СтрокаСостава = Элементы.Состав.ТекущиеДанные;
	Если СтрокаСостава = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтрокаСостава.Блюдо) Тогда

		ДанныеБлюда = ДанныеБлюдаДляСостава(
			СтрокаСостава.Блюдо, Объект.Ресторан, Объект.ДатаСоздания);

		Если ДанныеБлюда.БлюдоПодходит Тогда

			// Цена берётся из среза последних записей регистра «Цены блюд» на дату заказа.
			СтрокаСостава.Цена = ДанныеБлюда.Цена;

			Если Не ЗначениеЗаполнено(СтрокаСостава.Количество) Тогда
				СтрокаСостава.Количество = 1;
			КонецЕсли;

			ПересчитатьСуммуСтроки(СтрокаСостава);

		Иначе

			ПоказатьПояснение(СтрШаблон(
				НСтр("ru = 'Блюдо ""%1"" относится к другому ресторану. В заказ можно добавить только блюда ресторана ""%2"".'"),
				Строка(СтрокаСостава.Блюдо), Строка(Объект.Ресторан)));

			СтрокаСостава.Блюдо = Справочники.Блюда.ПустаяСсылка;
			СтрокаСостава.Цена = 0;
			СтрокаСостава.Сумма = 0;

		КонецЕсли;

	КонецЕсли;

	ПересчитатьСуммуДокумента();
	ОбновитьПредупреждениеОМинимальнойСумме();

КонецПроцедуры

&НаКлиенте
Процедура СоставКоличествоПриИзменении(Элемент)
	ПересчитатьТекущуюСтрокуСостава();
КонецПроцедуры

&НаКлиенте
Процедура СоставЦенаПриИзменении(Элемент)
	ПересчитатьТекущуюСтрокуСостава();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Клиент

&НаКлиенте
Процедура ПересчитатьТекущуюСтрокуСостава()

	СтрокаСостава = Элементы.Состав.ТекущиеДанные;
	Если СтрокаСостава = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаСостава.Количество) Тогда
		СтрокаСостава.Количество = 1;
	КонецЕсли;

	ПересчитатьСуммуСтроки(СтрокаСостава);
	ПересчитатьСуммуДокумента();
	ОбновитьПредупреждениеОМинимальнойСумме();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаСостава)

	СтрокаСостава.Сумма = Окр(СтрокаСостава.Количество * СтрокаСостава.Цена, 2);

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуДокумента()

	ОбщаяСумма = 0;

	Для Каждого СтрокаСостава Из Объект.Состав Цикл
		ОбщаяСумма = ОбщаяСумма + СтрокаСостава.Сумма;
	КонецЦикла;

	Объект.СуммаДокумента = Окр(ОбщаяСумма, 2);

КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьСменуРесторана()

	ПредыдущийРесторан = Объект.Ресторан;
	ОбновитьМинимальнуюСуммуЗаказа();
	ОбновитьПредупреждениеОМинимальнойСумме();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьМинимальнуюСуммуЗаказа()

	Если ЗначениеЗаполнено(Объект.Ресторан) Тогда
		МинимальнаяСуммаЗаказа = МинимальнаяСуммаЗаказаРесторана(Объект.Ресторан);
	Иначе
		МинимальнаяСуммаЗаказа = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредупреждениеОМинимальнойСумме()

	// Предупреждение показывается сразу, как только сумма стала меньше минимальной:
	// диспетчер видит проблему до записи заказа, запись при этом не блокируется.
	Если МинимальнаяСуммаЗаказа > 0 И Объект.СуммаДокумента < МинимальнаяСуммаЗаказа Тогда

		Элементы.ПредупреждениеМинимальнаяСумма.Заголовок = СтрШаблон(
			НСтр("ru = 'Внимание: сумма заказа %1 меньше минимальной суммы заказа ресторана (%2).'"),
			Формат(Объект.СуммаДокумента, "ЧДЦ=2"),
			Формат(МинимальнаяСуммаЗаказа, "ЧДЦ=2"));
		Элементы.ПредупреждениеМинимальнаяСумма.Видимость = Истина;

	Иначе

		Элементы.ПредупреждениеМинимальнаяСумма.Видимость = Ложь;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПояснение(ТекстПояснения)

	// Модальность в конфигурации запрещена - используем немодальное предупреждение.
	ПоказатьПредупреждение(Неопределено, ТекстПояснения, 5);

КонецПроцедуры

#КонецОбласти

#Область Сервер

&НаСервереБезКонтекста
Функция ДанныеБлюдаДляСостава(БлюдоСсылка, РесторанСсылка, МоментВремени)

	Результат = Новый Структура("БлюдоПодходит, Цена", Истина, 0);

	Если Не ЗначениеЗаполнено(БлюдоСсылка) Тогда
		Возврат Результат;
	КонецЕсли;

	Если ЗначениеЗаполнено(РесторанСсылка) И БлюдоСсылка.Ресторан <> РесторанСсылка Тогда
		Результат.БлюдоПодходит = Ложь;
		Возврат Результат;
	КонецЕсли;

	Результат.Цена = УправлениеДоставкой.ЦенаБлюдаНаДату(БлюдоСсылка, МоментВремени);

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОсновнойАдресДоставкиКлиента(КлиентСсылка)

	Если Не ЗначениеЗаполнено(КлиентСсылка) Тогда
		Возврат "";
	КонецЕсли;

	Возврат КлиентСсылка.ОсновнойАдресДоставки;

КонецФункции

&НаСервереБезКонтекста
Функция МинимальнаяСуммаЗаказаРесторана(РесторанСсылка)

	Если Не ЗначениеЗаполнено(РесторанСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат РесторанСсылка.МинимальнаяСуммаЗаказа;

КонецФункции

#КонецОбласти

#КонецОбласти