&НаСервере
Процедура КлиентПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.Клиент) Тогда
		
		КлиентОбъект = Объект.Клиент.ПолучитьОбъект();
		Объект.АдресДоставки = КлиентОбъект.ОсновнойАдресДоставки;		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	КлиентПриИзмененииНаСервере();
КонецПроцедуры
&НаКлиенте
Процедура БлюдаЗаказаБлюдоПриИзменении(Элемент)	
	
	СтрокаТЧ = Элементы.БлюдаЗаказа.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(СтрокаТЧ.Блюдо) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка на один ресторан
	Если Не ПроверитьБлюдоПоРесторануНаСервере(Объект.Ресторан, СтрокаТЧ.Блюдо) Тогда
		Сообщить("Нельзя добавить блюдо из другого ресторана");
		СтрокаТЧ.Блюдо = Неопределено;
		Возврат;
	КонецЕсли;
	
	СтрокаТЧ.Цена = ПолучитьАктуальнуюЦенуБлюда(СтрокаТЧ.Блюдо);
	СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
	
	ПересчитатьИтоговуюСумму();
	
КонецПроцедуры  
&НаСервереБезКонтекста
Функция ПроверитьБлюдоПоРесторануНаСервере(РесторанСсылка, БлюдоСсылка)
	
	Если Не ЗначениеЗаполнено(РесторанСсылка) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(БлюдоСсылка) Тогда
		Возврат Истина;
	КонецЕсли;
	
	БлюдоОбъект = БлюдоСсылка.ПолучитьОбъект();
	
	Если БлюдоОбъект.Ресторан = РесторанСсылка Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции
&НаСервереБезКонтекста
Функция ПолучитьАктуальнуюЦенуБлюда(Блюдо)
	
	Отбор = Новый Структура("Блюдо", Блюдо);
	ЗаписьЦены = РегистрыСведений.ЦеныБлюд.ПолучитьПоследнее(ТекущаяДата(), Отбор);
	
	Если ЗначениеЗаполнено(ЗаписьЦены.Цена) Тогда
		Возврат ЗаписьЦены.Цена;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции    

&НаКлиенте
Процедура ПересчитатьИтоговуюСумму()
	
	Итог = 0;
	
	Для Каждого Стр Из Объект.БлюдаЗаказа Цикл
		Итог = Итог + Стр.Сумма;
	КонецЦикла;
	
	Объект.ИтоговаяСумма = Итог;
	
КонецПроцедуры

&НаКлиенте
Процедура БлюдаЗаказаКоличествоПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.БлюдаЗаказа.ТекущиеДанные;
	СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
	ПересчитатьИтоговуюСумму();
	
КонецПроцедуры


&НаКлиенте
Процедура БлюдаЗаказаЦенаПриИзменении(Элемент)
	
	СтрокаТЧ = Элементы.БлюдаЗаказа.ТекущиеДанные;
	СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
	ПересчитатьИтоговуюСумму();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ПередЗаписьюНаСервере(Отказ);
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ)
	
	
	// Статус по умолчанию
	Если Не ЗначениеЗаполнено(Объект.СтатусЗаказа) Тогда
		Объект.СтатусЗаказа = Перечисления.СтатусыЗаказов.Новый;
	КонецЕсли;
		
Если Объект.СтатусЗаказа = Перечисления.СтатусыЗаказов.Доставлен Тогда
	
	Если Не ЗначениеЗаполнено(Объект.ФактическоеВремяДоставки) Тогда
		Объект.ФактическоеВремяДоставки = ТекущаяДата();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДатаВремяСозданияЗаказа)
		И ЗначениеЗаполнено(Объект.ФактическоеВремяДоставки) Тогда
		
		Объект.ВремяДоставкиМинуты = Цел((Объект.ФактическоеВремяДоставки - Объект.ДатаВремяСозданияЗаказа) / 60);
		
	КонецЕсли;
	
КонецЕсли;	
	// Проверка минимальной суммы заказа
	Если ЗначениеЗаполнено(Объект.Ресторан) Тогда
		
		РесторанОбъект = Объект.Ресторан.ПолучитьОбъект();
		
		Если Объект.ИтоговаяСумма < РесторанОбъект.МинимальнаяСуммаЗаказа Тогда
			Сообщить("Сумма заказа ниже минимальной суммы заказа ресторана");
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры     


