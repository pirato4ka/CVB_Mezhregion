Перем мПредыдущийКурьер;

// Модуль объекта документа Заказ.
// Отвечает за расчет сумм, проверку состава, расчет времени доставки
// и синхронизацию статусов курьеров с заказами.

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(ДатаСоздания) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ДатаСоздания;
	КонецЕсли;

	мПредыдущийКурьер = ПолучитьКурьераИзБазы();

	ПересчитатьСуммы();
	ПроверитьСостав(Отказ);
	ПроверитьКурьера(Отказ);
	ПроверитьМинимальнуюСумму();
	ЗаполнитьФактическоеВремяДоставки();

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	УстановитьПривилегированныйРежим(Истина);

	// Курьер, с которым заказ был связан раньше, мог освободиться.
	Если ЗначениеЗаполнено(мПредыдущийКурьер) И мПредыдущийКурьер <> Курьер Тогда
		ОсвободитьКурьера(мПредыдущийКурьер);
	КонецЕсли;

	Если ЗначениеЗаполнено(Курьер) Тогда
		Если Статус = Перечисления.СтатусыЗаказов.ПереданКурьеру Тогда
			ПометитьКурьераЗанятым(Курьер);
		Иначе
			ОсвободитьКурьера(Курьер);
		КонецЕсли;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Возвращает курьера, записанного в заказе до текущей записи.
Функция ПолучитьКурьераИзБазы()

	Если Ссылка.Пустая() Тогда
		Возврат Справочники.Курьеры.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Заказ.Курьер КАК Курьер
	|ИЗ
	|	Документ.Заказ КАК Заказ
	|ГДЕ
	|	Заказ.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Курьер;
	КонецЕсли;

	Возврат Справочники.Курьеры.ПустаяСсылка();

КонецФункции

Процедура ПересчитатьСуммы()

	Для Каждого СтрокаСостава Из Состав Цикл
		СтрокаСостава.Сумма = Окр(СтрокаСостава.Количество * СтрокаСостава.Цена, 2);
	КонецЦикла;

	СуммаДокумента = Окр(Состав.Итог("Сумма"), 2);

КонецПроцедуры

Процедура ПроверитьСостав(Отказ)

	Если Состав.Количество() = 0 Тогда
		Сообщить("В заказе не указано ни одного блюда.", СтатусСообщения.Важное);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаСостава Из Состав Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаСостава.Блюдо) Тогда
			Продолжить;
		КонецЕсли;

		// Заказ формируется только из блюд одного ресторана.
		Если ЗначениеЗаполнено(Ресторан) И СтрокаСостава.Блюдо.Ресторан <> Ресторан Тогда
			Сообщить("Блюдо """ + Строка(СтрокаСостава.Блюдо) + """ не относится к ресторану """
				+ Строка(Ресторан) + """. В заказ можно добавлять блюда только одного ресторана.",
				СтатусСообщения.Важное);
			Отказ = Истина;
		КонецЕсли;

		Если СтрокаСостава.Количество <= 0 Тогда
			Сообщить("Количество блюда """ + Строка(СтрокаСостава.Блюдо) + """ должно быть больше нуля.",
				СтатусСообщения.Важное);
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьКурьера(Отказ)

	// Проверяем только при назначении нового курьера, чтобы не блокировать
	// завершение уже выполняемых заказов.
	Если ЗначениеЗаполнено(Курьер) И Курьер <> мПредыдущийКурьер
		И Курьер.ТекущийСтатус = Перечисления.СтатусыКурьеров.НеНаСмене Тогда

		Сообщить("Курьер """ + Строка(Курьер) + """ сейчас не на смене. Выберите другого курьера.",
			СтатусСообщения.Важное);
		Отказ = Истина;

	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьМинимальнуюСумму()

	Если НЕ ЗначениеЗаполнено(Ресторан) Тогда
		Возврат;
	КонецЕсли;

	Если СуммаДокумента < Ресторан.МинимальнаяСуммаЗаказа Тогда
		Сообщить("Внимание: сумма заказа меньше минимальной суммы для ресторана!", СтатусСообщения.Внимание);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьФактическоеВремяДоставки()

	Если Статус <> Перечисления.СтатусыЗаказов.Доставлен Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ФактическоеВремяДоставки) Тогда
		ФактическоеВремяДоставки = ТекущаяДатаСеанса();
	КонецЕсли;

	ВремяДоставкиМинут = Макс(0, Окр((ФактическоеВремяДоставки - ДатаСоздания) / 60, 0));

КонецПроцедуры

// Переводит курьера в статус Занят, если он был Свободен.
Процедура ПометитьКурьераЗанятым(ТекущийКурьер)

	Если ТекущийКурьер.ТекущийСтатус <> Перечисления.СтатусыКурьеров.Свободен Тогда
		Возврат;
	КонецЕсли;

	ЗаблокироватьКурьера(ТекущийКурьер);

	ОбъектКурьера = ТекущийКурьер.ПолучитьОбъект();
	ОбъектКурьера.ТекущийСтатус = Перечисления.СтатусыКурьеров.Занят;
	ОбъектКурьера.Записать();

КонецПроцедуры

// Освобождает курьера, если у него не осталось заказов в статусе Передан курьеру.
Процедура ОсвободитьКурьера(ТекущийКурьер)

	Если ЕстьЗаказыКурьераВРаботе(ТекущийКурьер) Тогда
		Возврат;
	КонецЕсли;

	ЗаблокироватьКурьера(ТекущийКурьер);

	ОбъектКурьера = ТекущийКурьер.ПолучитьОбъект();
	Если ОбъектКурьера.ТекущийСтатус = Перечисления.СтатусыКурьеров.Занят Тогда
		ОбъектКурьера.ТекущийСтатус = Перечисления.СтатусыКурьеров.Свободен;
		ОбъектКурьера.Записать();
	КонецЕсли;

КонецПроцедуры

Функция ЕстьЗаказыКурьераВРаботе(ТекущийКурьер)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.Заказ КАК Заказ
	|ГДЕ
	|	Заказ.Курьер = &Курьер
	|	И Заказ.Статус = &Статус";
	Запрос.УстановитьПараметр("Курьер", ТекущийКурьер);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказов.ПереданКурьеру);

	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Процедура ЗаблокироватьКурьера(ТекущийКурьер)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.Курьеры");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ТекущийКурьер);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

КонецПроцедуры
