///////////////////////////////////////////////////////////////////////////////////////////////////////
// Модуль документа Заказ.
//
// Правила, заданные в техническом задании:
//   * заказ нельзя сохранить без клиента и ресторана;
//   * в состав заказа можно включить только блюда ресторана заказа;
//   * сумма заказа рассчитывается автоматически по составу;
//   * если сумма меньше минимальной суммы заказа ресторана - пользователь
//     получает предупреждение (заказ при этом сохраняется, отказа нет);
//   * при переходе в статус Доставлен фиксируются фактическое время доставки
//     и время доставки в минутах;
//   * после завершения доставки курьер освобождается, если у него не осталось
//     других заказов в работе.
///////////////////////////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	ЗаполнитьДатуСоздания();
	ЗаполнитьАдресДоставки();

	Если Не ПроверитьОбязательныеРеквизиты() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Не ПроверитьСоставЗаказа() Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	РассчитатьСуммыЗаказа();
	ОбработатьСменуСтатуса();
	ПредупредитьОМинимальнойСуммеЗаказа();

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	// Курьер освобождается, когда доставленных или отмененных заказов у него
	// больше нет; остается занятым, пока в очереди есть переданные ему заказы.
	УправлениеДоставкой.ОбновитьСтатусКурьера(Курьер);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьДатуСоздания()

	Если Не ЗначениеЗаполнено(ДатаСоздания) Тогда
		ДатаСоздания = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыЗаказов.Новый;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьАдресДоставки()

	// Адрес доставки подставляется из карточки клиента, если диспетчер его не указал.
	Если Не ЗначениеЗаполнено(АдресДоставки) И ЗначениеЗаполнено(Клиент) Тогда
		АдресДоставки = Клиент.ОсновнойАдресДоставки;
	КонецЕсли;

КонецПроцедуры

Функция ПроверитьОбязательныеРеквизиты()

	ПроверкаПройдена = Истина;

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		СообщитьОбОшибке(
			НСтр("ru = 'Не указан клиент. Заказ нельзя сохранить без клиента.'"), "Клиент");
		ПроверкаПройдена = Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ресторан) Тогда
		СообщитьОбОшибке(
			НСтр("ru = 'Не указан ресторан. Заказ нельзя сохранить без ресторана.'"), "Ресторан");
		ПроверкаПройдена = Ложь;
	КонецЕсли;

	Возврат ПроверкаПройдена;

КонецФункции

Функция ПроверитьСоставЗаказа()

	ПроверкаСостава = УправлениеДоставкой.СоставСоответствуетРесторану(Ресторан, Состав);

	Если ПроверкаСостава.Результат Тогда
		Возврат Истина;
	КонецЕсли;

	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Блюдо ""%1"" (строка %2) не относится к ресторану ""%3"". В заказ можно включить только блюда выбранного ресторана.'"),
		Строка(ПроверкаСостава.Блюдо),
		ПроверкаСостава.Строка,
		Строка(Ресторан));

	СообщитьОбОшибке(ТекстСообщения, "Состав");

	Возврат Ложь;

КонецФункции

Процедура РассчитатьСуммыЗаказа()

	ОбщаяСумма = 0;

	Для Каждого СтрокаСостава Из Состав Цикл

		// Пустое количество трактуется как одна порция.
		Если Не ЗначениеЗаполнено(СтрокаСостава.Количество) Тогда
			СтрокаСостава.Количество = 1;
		КонецЕсли;

		СтрокаСостава.Сумма = Окр(СтрокаСостава.Количество * СтрокаСостава.Цена, 2);
		ОбщаяСумма = ОбщаяСумма + СтрокаСостава.Сумма;

	КонецЦикла;

	СуммаДокумента = Окр(ОбщаяСумма, 2);

КонецПроцедуры

Процедура ОбработатьСменуСтатуса()

	Если Статус = Перечисления.СтатусыЗаказов.Доставлен Тогда

		Если Не ЗначениеЗаполнено(ФактическоеВремяДоставки) Тогда
			ФактическоеВремяДоставки = ТекущаяДатаСеанса();
		КонецЕсли;

		ВремяДоставкиМинут = УправлениеДоставкой.МинутыДоставки(
			ДатаСоздания, ФактическоеВремяДоставки);

	Иначе

		// Доставка ещё не завершена или заказ отменен - фактических показателей нет.
		ФактическоеВремяДоставки = Дата(1, 1, 1);
		ВремяДоставкиМинут = 0;

	КонецЕсли;

КонецПроцедуры

Процедура ПредупредитьОМинимальнойСуммеЗаказа()

	Если Не ЗначениеЗаполнено(Ресторан) Тогда
		Возврат;
	КонецЕсли;

	МинимальнаяСуммаЗаказа = Ресторан.МинимальнаяСуммаЗаказа;

	Если МинимальнаяСуммаЗаказа <= 0 Или СуммаДокумента >= МинимальнаяСуммаЗаказа Тогда
		Возврат;
	КонецЕсли;

	// Требование задания: это предупреждение, а не отказ от записи.
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Сумма заказа %1 меньше минимальной суммы заказа ресторана (%2). Заказ сохранен, уточните состав заказа у клиента.'"),
		Формат(СуммаДокумента, "ЧДЦ=2"),
		Формат(МинимальнаяСуммаЗаказа, "ЧДЦ=2"));

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Статус = СтатусСообщения.Внимание;
	Сообщение.Поле = "СуммаДокумента";
	Сообщение.ПутьКДанным = "Объект";
	Сообщение.Сообщить();

КонецПроцедуры

Процедура СообщитьОбОшибке(ТекстСообщения, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Статус = СтатусСообщения.Важное;
	Сообщение.Поле = Поле;
	Сообщение.ПутьКДанным = "Объект";
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти