		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Состав.Блюдо КАК Блюдо,
	Состав.Блюдо.Категория КАК Категория,
	Состав.Количество КАК Количество
ИЗ
	Документ.Заказ.Состав КАК Состав
ГДЕ
	Состав.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И Состав.Ссылка.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Отменен)
	И (&amp;Категория = ЗНАЧЕНИЕ(Справочник.КатегорииБлюд.ПустаяСсылка)
			ИЛИ Состав.Блюдо.Категория = &amp;Категория)</query>
	</dataSet>
