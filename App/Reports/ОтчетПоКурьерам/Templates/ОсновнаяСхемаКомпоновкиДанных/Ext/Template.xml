		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Заказ.Курьер КАК Курьер,
	Заказ.Курьер.ТипТранспорта КАК ТипТранспорта,
	Заказ.Ссылка КАК Заказ,
	Заказ.Дата КАК Дата,
	Заказ.ФактическоеВремяДоставки КАК ФактическоеВремяДоставки,
	Заказ.ВремяДоставкиМинут КАК ВремяДоставкиМинут,
	Заказ.СуммаДокумента КАК СуммаДокумента
ИЗ
	Документ.Заказ КАК Заказ
ГДЕ
	Заказ.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И Заказ.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Доставлен)
	И Заказ.Курьер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Курьеры.ПустаяСсылка)</query>
	</dataSet>
