&НаКлиенте
Процедура ПрименитьФильтры(Команда)
	ПрименитьФильтрыНаСервере();
	Элементы.СписокЗаказов.Обновить();
КонецПроцедуры


&НаСервере
Процедура ПрименитьФильтрыНаСервере()
	
	СписокЗаказов.Отбор.Элементы.Очистить();
	
	Если ЗначениеЗаполнено(ФильтрРесторан) Тогда
		ЭлементОтбора = СписокЗаказов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ресторан");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ФильтрРесторан;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФильтрСтатусЗаказов) Тогда
		ЭлементОтбора = СписокЗаказов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СтатусЗаказа");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ФильтрСтатусЗаказов;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФильтрКурьер) Тогда
		ЭлементОтбора = СписокЗаказов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Курьер");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ФильтрКурьер;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СброситьФильтры(Команда)
	
	ФильтрРесторан = Неопределено;
	ФильтрСтатусЗаказа = Неопределено;
	ФильтрКурьер = Неопределено;
	
	СброситьФильтрыНаСервере();
	Элементы.СписокЗаказов.Обновить();
	
КонецПроцедуры


&НаСервере
Процедура СброситьФильтрыНаСервере()
	СписокЗаказов.Отбор.Элементы.Очистить();
КонецПроцедуры


&НаКлиенте
Процедура НазначитьКурьера(Команда)
	
	Если Элементы.СписокЗаказов.ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите заказ");
		Возврат;
	КонецЕсли;
	
	Если Элементы.СписокКурьеров.ТекущиеДанные = Неопределено Тогда
		Сообщить("Выберите курьера");
		Возврат;
	КонецЕсли;
	
	НазначитьКурьераНаСервере(
		Элементы.СписокЗаказов.ТекущиеДанные.Ссылка,
		Элементы.СписокКурьеров.ТекущиеДанные.Ссылка);
	
	Элементы.СписокЗаказов.Обновить();
	Элементы.СписокКурьеров.Обновить();
	
КонецПроцедуры


&НаСервере
Процедура НазначитьКурьераНаСервере(СсылкаЗаказа, СсылкаКурьера)
	
	ЗаказОбъект = СсылкаЗаказа.ПолучитьОбъект();
	ЗаказОбъект.Курьер = СсылкаКурьера;
	ЗаказОбъект.Записать();
	
КонецПроцедуры