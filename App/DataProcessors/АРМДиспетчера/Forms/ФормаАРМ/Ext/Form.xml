	<Attributes>
		<Attribute name="Заказы" id="72">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<MainTable>Document.Заказ</MainTable>
				<QueryText>ВЫБРАТЬ
					Заказ.Ссылка КАК Ссылка,
					Заказ.Номер КАК Номер,
					Заказ.ДатаСоздания КАК ДатаСоздания,
					Заказ.Ресторан КАК Ресторан,
					Заказ.Клиент КАК Клиент,
					Заказ.АдресДоставки КАК АдресДоставки,
					Заказ.Статус КАК Статус,
					Заказ.ПлановоеВремяДоставки КАК ПлановоеВремяДоставки,
					Заказ.Курьер КАК Курьер,
					Заказ.СуммаДокумента КАК СуммаДокумента
				ИЗ
					Документ.Заказ КАК Заказ
				ГДЕ
					(НЕ &amp;ИспользоватьСтатус И Заказ.Статус В (&amp;СтатусыАктивные) ИЛИ &amp;ИспользоватьСтатус И Заказ.Статус = &amp;Статус)
					И (НЕ &amp;ИспользоватьРесторан ИЛИ Заказ.Ресторан = &amp;Ресторан)
					И (НЕ &amp;ИспользоватьКурьера ИЛИ Заказ.Курьер = &amp;Курьер)
				УПОРЯДОЧИТЬ ПО
					ПлановоеВремяДоставки,
					ДатаСоздания</QueryText>
			</Settings>
		</Attribute>
		<Attribute name="Курьеры" id="73">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<MainTable>Catalog.Курьеры</MainTable>
				<QueryText>ВЫБРАТЬ
					Курьеры.Ссылка КАК Ссылка,
					Курьеры.Наименование КАК Наименование,
					Курьеры.Телефон КАК Телефон,
					Курьеры.ТипТранспорта КАК ТипТранспорта,
					Курьеры.ТекущийСтатус КАК ТекущийСтатус,
					ЕСТЬNULL(Очередь.КоличествоВОчереди, 0) КАК КоличествоЗаказовВОчереди
				ИЗ
					Справочник.Курьеры КАК Курьеры
					ЛЕВОЕ СОЕДИНЕНИЕ
					(
					ВЫБРАТЬ
						Заказ.Курьер КАК Курьер,
						КОЛИЧЕСТВО(Заказ.Ссылка) КАК КоличествоВОчереди
					ИЗ
						Документ.Заказ КАК Заказ
					ГДЕ
						Заказ.Курьер &lt;&gt; ЗНАЧЕНИЕ(Справочник.Курьеры.ПустаяСсылка)
						И НЕ Заказ.Статус В (ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Доставлен), ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказов.Отменен))
					СГРУППИРОВАТЬ ПО
						Заказ.Курьер
					) КАК Очередь
					ПО Курьеры.Ссылка = Очередь.Курьер
				УПОРЯДОЧИТЬ ПО
					Наименование</QueryText>
			</Settings>
		</Attribute>
		<Attribute name="ФильтрРесторан" id="74">
			<Type>
				<v8:Type>cfg:CatalogRef.Рестораны</v8:Type>
			</Type>
