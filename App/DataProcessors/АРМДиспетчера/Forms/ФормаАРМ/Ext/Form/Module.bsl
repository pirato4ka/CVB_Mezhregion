// Форма АРМ диспетчера.
// Зона 1 - динамический список активных заказов, зона 2 - список курьеров.
// Назначение курьера выполняется без открытия карточки заказа.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Заказы.Параметры.УстановитьЗначениеПараметра("СтатусыАктивные", МассивАктивныхСтатусов());
	ПрименитьФильтрыНаСервере();
	УстановитьУсловноеОформление();

КонецПроцедуры

&НаСервере
Функция МассивАктивныхСтатусов()

	Результат = Новый Массив;
	Результат.Добавить(Перечисления.СтатусыЗаказов.Новый);
	Результат.Добавить(Перечисления.СтатусыЗаказов.Готовится);
	Результат.Добавить(Перечисления.СтатусыЗаказов.ПереданКурьеру);
	Возврат Результат;

КонецФункции

// Фильтры

&НаКлиенте
Процедура ФильтрПриИзменении(Элемент)

	ПрименитьФильтрыНаСервере();
	Элементы.ТаблицаЗаказов.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура СброситьФильтры(Команда)

	СброситьФильтрыНаСервере();
	Элементы.ТаблицаЗаказов.Обновить();
	Элементы.ТаблицаКурьеров.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписки(Команда)

	Элементы.ТаблицаЗаказов.Обновить();
	Элементы.ТаблицаКурьеров.Обновить();

КонецПроцедуры

&НаСервере
Процедура СброситьФильтрыНаСервере()

	ФильтрРесторан = Справочники.Рестораны.ПустаяСсылка();
	ФильтрСтатус = Перечисления.СтатусыЗаказов.ПустаяСсылка();
	ФильтрКурьер = Справочники.Курьеры.ПустаяСсылка();
	ПрименитьФильтрыНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПрименитьФильтрыНаСервере()

	Заказы.Параметры.УстановитьЗначениеПараметра("ИспользоватьРесторан", ЗначениеЗаполнено(ФильтрРесторан));
	Заказы.Параметры.УстановитьЗначениеПараметра("Ресторан", ФильтрРесторан);
	Заказы.Параметры.УстановитьЗначениеПараметра("ИспользоватьСтатус", ЗначениеЗаполнено(ФильтрСтатус));
	Заказы.Параметры.УстановитьЗначениеПараметра("Статус", ФильтрСтатус);
	Заказы.Параметры.УстановитьЗначениеПараметра("ИспользоватьКурьера", ЗначениеЗаполнено(ФильтрКурьер));
	Заказы.Параметры.УстановитьЗначениеПараметра("Курьер", ФильтрКурьер);

КонецПроцедуры

// Назначение курьера

&НаКлиенте
Процедура НазначитьКурьера(Команда)

	ДанныеЗаказа = Элементы.ТаблицаЗаказов.ТекущиеДанные;
	ДанныеКурьера = Элементы.ТаблицаКурьеров.ТекущиеДанные;

	Если ДанныеЗаказа = Неопределено Тогда
		Сообщить("Выберите заказ в списке активных заказов.", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	Если ДанныеКурьера = Неопределено Тогда
		Сообщить("Выберите курьера в списке курьеров.", СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;

	ТекстОшибки = НазначитьКурьераНаЗаказ(ДанныеЗаказа.Ссылка, ДанныеКурьера.Ссылка);

	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Сообщить(ТекстОшибки, СтатусСообщения.Важное);
	Иначе
		Сообщить("Курьер """ + Строка(ДанныеКурьера.Наименование) + """ назначен на заказ "
			+ Строка(ДанныеЗаказа.Номер) + ".", СтатусСообщения.Информация);
	КонецЕсли;

	Элементы.ТаблицаЗаказов.Обновить();
	Элементы.ТаблицаКурьеров.Обновить();

КонецПроцедуры

// Двойной щелчок по заказу не открывает карточку: работа ведется в одном окне.
&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

КонецПроцедуры

// Возвращает пустую строку, если курьер назначен; иначе текст причины отказа.
&НаСервере
Функция НазначитьКурьераНаЗаказ(ЗаказСсылка, КурьерСсылка)

	Если КурьерСсылка.ТекущийСтатус = Перечисления.СтатусыКурьеров.НеНаСмене Тогда
		Возврат "Курьер не на смене. Назначение невозможно.";
	КонецЕсли;

	Попытка
		НачатьТранзакцию();

		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Документ.Заказ");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ЗаказСсылка);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();

		ОбъектЗаказа = ЗаказСсылка.ПолучитьОбъект();

		Если ОбъектЗаказа.Статус = Перечисления.СтатусыЗаказов.Доставлен
			ИЛИ ОбъектЗаказа.Статус = Перечисления.СтатусыЗаказов.Отменен Тогда
			ОтменитьТранзакцию();
			Возврат "Заказ уже завершен и не может быть передан курьеру.";
		КонецЕсли;

		ОбъектЗаказа.Курьер = КурьерСсылка;
		Если ОбъектЗаказа.Статус = Перечисления.СтатусыЗаказов.Новый
			ИЛИ ОбъектЗаказа.Статус = Перечисления.СтатусыЗаказов.Готовится Тогда
			ОбъектЗаказа.Статус = Перечисления.СтатусыЗаказов.ПереданКурьеру;
		КонецЕсли;

		Если НЕ ОбъектЗаказа.Записать() Тогда
			ОтменитьТранзакцию();
			Возврат "Заказ не записан: проверьте состав заказа и курьера.";
		КонецЕсли;

		ЗафиксироватьТранзакцию();
		Возврат "";

	Исключение
		ОтменитьТранзакцию();
		Возврат "Не удалось назначить курьера: " + ОписаниеОшибки();
	КонецПопытки;

КонецФункции

// Условное оформление

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ДобавитьОформлениеПоЗначению("Статус", Перечисления.СтатусыЗаказов.Новый, Новый Цвет(221, 240, 255), "Новый");
	ДобавитьОформлениеПоЗначению("Статус", Перечисления.СтатусыЗаказов.Готовится, Новый Цвет(255, 246, 200), "Готовится");
	ДобавитьОформлениеПоЗначению("Статус", Перечисления.СтатусыЗаказов.ПереданКурьеру, Новый Цвет(230, 230, 230), "Передан курьеру");
	ДобавитьОформлениеПоЗначению("ТекущийСтатус", Перечисления.СтатусыКурьеров.Свободен, Новый Цвет(214, 240, 214), "Свободен");
	ДобавитьОформлениеПоЗначению("ТекущийСтатус", Перечисления.СтатусыКурьеров.Занят, Новый Цвет(255, 224, 196), "Занят");
	ДобавитьОформлениеПоЗначению("ТекущийСтатус", Перечисления.СтатусыКурьеров.НеНаСмене, Новый Цвет(240, 240, 240), "Не на смене");

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеПоЗначению(ИмяПоля, Значение, Цвет, Представление)

	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = Представление;
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", Цвет);

	ЭлементОтбора = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Значение;
	ЭлементОтбора.Использование = Истина;

КонецПроцедуры
